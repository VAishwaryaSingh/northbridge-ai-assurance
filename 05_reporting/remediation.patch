+"""Regression tests (review finding F-06). Run: python -m unittest discover -s tests -t .
+Small in-memory ledgers only; no network, no real data."""
+import random
+import sqlite3
+import tempfile
+import unittest
+from pathlib import Path
+
+from src.anomaly.rules import find_duplicate_invoices, find_threshold_adjacent_round_amounts
+from src.pipeline import a6_from_reconciliation, detect_all
+from src.reconciliation.matcher import build_reconciliation_report, match_bank_transactions
+from src.variance.explainer import explain_movement
+
+SCHEMA = (Path(__file__).resolve().parent.parent / "src/db/schema.sql").read_text()
+
+
+def ledger():
+    c = sqlite3.connect(":memory:")
+    c.executescript(SCHEMA)
+    for cid, name in [("C1", "Alder Group"), ("S1", "Brightside Print"), ("S2", "Kestrel Couriers")]:
+        c.execute("INSERT INTO contacts VALUES (?,?,?,?)", (cid, name, cid.startswith("C"), cid.startswith("S")))
+    return c
+
+
+def inv(c, iid, cid, typ, date, total, due=None, acct="425"):
+    c.execute("INSERT INTO invoices VALUES (?,?,?,?,?,?,?,?)", (iid, cid, typ, date + "T00:00:00", (due or date) + "T00:00:00", total, "INPUT2", "AUTHORISED"))
+    c.execute("INSERT INTO line_items VALUES (?,?,?,?,?,?,?,?,?)", (iid + "-L1", iid, acct, "x", 1, total, total, "INPUT2", 0))
+
+
+def bank(c, bid, cid, date, total, typ="RECEIVE"):
