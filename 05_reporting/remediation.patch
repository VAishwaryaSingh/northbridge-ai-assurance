new file mode 100644
index 0000000..5db81ad
--- /dev/null
+++ b/src/run_log.py
@@ -0,0 +1,69 @@
+"""Append-only run log (remediation of review finding F-03).
+
+Each detection run can record: run id, UTC time, tool version, git commit, input hash, dependency
+versions, user, and a hash of the output. Enable by passing log_path to detect_all() or setting the
+NORTHBRIDGE_RUN_LOG environment variable to a SQLite file path. Logging is off by default so existing
+behaviour is unchanged.
+"""
+
+from __future__ import annotations
+
+import getpass
+import hashlib
+import json
+import sqlite3
+import subprocess
+import uuid
+from datetime import datetime, timezone
+from importlib import metadata
+
+from src.version import __version__
+
+_SCHEMA = """CREATE TABLE IF NOT EXISTS run_log (
+    run_id TEXT PRIMARY KEY, run_utc TEXT NOT NULL, tool_version TEXT, git_commit TEXT,
+    input_hash TEXT NOT NULL, output_hash TEXT NOT NULL, flag_count INTEGER, dependencies TEXT, run_user TEXT
+)"""
+_TABLES = ("accounts", "contacts", "invoices", "bank_transactions", "payments", "line_items")
+
+
+def input_hash(conn: sqlite3.Connection) -> str:
+    """Hash of the ledger content, independent of row order."""
+    h = hashlib.sha256()
+    for t in _TABLES:
+        rows = sorted(repr(r) for r in conn.execute(f"SELECT * FROM {t}"))
+        h.update(t.encode())
+        h.update("\n".join(rows).encode())
+    return h.hexdigest()
+
+
+def output_hash(detected: list[dict]) -> str:
+    return hashlib.sha256("\n".join(sorted(json.dumps(d, sort_keys=True, default=str) for d in detected)).encode()).hexdigest()
+
+
+def _git_commit() -> str:
+    try:
+        return subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True, timeout=5).stdout.strip() or "unknown"
+    except Exception:
+        return "unknown"
+
+
+def _deps() -> dict:
+    out = {}
+    for p in ("pandas", "scikit-learn", "streamlit", "requests"):
+        try:
+            out[p] = metadata.version(p)
+        except metadata.PackageNotFoundError:
+            out[p] = "not installed"
+    return out
+
+
+def log_run(log_path: str, conn: sqlite3.Connection, detected: list[dict]) -> str:
+    run_id = str(uuid.uuid4())
+    with sqlite3.connect(log_path) as log:
+        log.execute(_SCHEMA)
+        log.execute(
+            "INSERT INTO run_log VALUES (?,?,?,?,?,?,?,?,?)",
+            (run_id, datetime.now(timezone.utc).isoformat(timespec="seconds"), __version__, _git_commit(),
+             input_hash(conn), output_hash(detected), len(detected), json.dumps(_deps()), getpass.getuser()),
+        )
+    return run_id
