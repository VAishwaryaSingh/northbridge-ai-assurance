+            inv(c, f"AR{i+1}", "C1", "ACCREC", d, 1200.0, due=d[:8] + "28")
+        c.execute("INSERT INTO payments VALUES ('P1','AR1',NULL,'2026-02-10T00:00:00',1200,'ACCRECPAYMENT','AUTHORISED')")
+        bank(c, "BT1", "C1", "2026-03-09", 1200.0)  # receipt intended for AR2
+        return c
+
+    def test_recurring_receipt_not_attributed_to_paid_invoice(self):  # F-02
+        m = {r["bank_transaction_id"]: r for r in match_bank_transactions(self.recurring())}
+        self.assertNotEqual(m["BT1"]["matched_invoice_id"], "AR1")
+        flags = detect_all(self.recurring(), build_reconciliation_report(match_bank_transactions(self.recurring())))
+        self.assertFalse([f for f in flags if f["target_anomaly_id"] == "A5"])
+
+    def test_true_duplicate_payment_still_flagged(self):
+        c = ledger(); inv(c, "B1", "S1", "ACCPAY", "2026-03-02", 300.0, due="2026-04-01")
+        c.execute("INSERT INTO payments VALUES ('P1','B1',NULL,'2026-03-20T00:00:00',300,'ACCPAYPAYMENT','AUTHORISED')")
+        bank(c, "BT1", "S1", "2026-03-25", 300.0, "SPEND")
+        flags = detect_all(c, build_reconciliation_report(match_bank_transactions(c)))
+        self.assertEqual([f["record_id"] for f in flags if f["target_anomaly_id"] == "A5"], ["BT1"])
+
+    def test_output_independent_of_row_order(self):  # F-02 / determinism criterion
+        def build(order_seed):
+            c = ledger(); rows = []
+            for i in range(6): rows.append(("AR%d" % i, "C1", "ACCREC", "2026-%02d-15" % (i + 1), 1200.0))
+            random.Random(order_seed).shuffle(rows)
+            for r in rows: inv(c, r[0], r[1], r[2], r[3], r[4], due=r[3][:8] + "28")
+            for k, (bid, d) in enumerate([("BT1", "2026-02-10"), ("BT2", "2026-03-12"), ("BT3", "2026-04-11")]): bank(c, bid, "C1", d, 1200.0)
+            return c
+        results = {tuple((m["bank_transaction_id"], m["matched_invoice_id"], m["match_status"]) for m in match_bank_transactions(build(s))) for s in range(8)}
+        self.assertEqual(len(results), 1)
