+"""Detection parameters in one place (remediation of review finding F-12).
+
+Each value is a fixed constant chosen by the developer for the demo data. None has been approved by a
+control owner. When the tool is used beyond a demo, the owner should record the rationale, approver and
+date in PARAMETER_APPROVAL below and change values only through that record.
+"""
+
+# Reconciliation (src/reconciliation/matcher.py)
+AMOUNT_TOLERANCE_ABS = 5.0    # flat tolerance in GBP for a "probable" match
+AMOUNT_TOLERANCE_PCT = 0.02   # relative tolerance for a "probable" match
+EXACT_TOLERANCE_ABS = 0.01    # tolerance for an "exact" match
+EXACT_DATE_WINDOW_DAYS = 30   # invoice/due date within this many days = exact
+PROBABLE_DATE_WINDOW_DAYS = 45
+
+# Rules (src/anomaly/rules.py)
+A1_DUPLICATE_WINDOW_DAYS = 10   # same contact, same total, within this many days
+A3_APPROVAL_THRESHOLD = 500.0   # GBP approval limit assumed for the demo company
+A3_BAND = 0.95                  # flag bills from 95% up to the threshold
+
+PARAMETER_APPROVAL = {"approved_by": None, "approved_on": None, "rationale": None}  # to be completed by the owner
